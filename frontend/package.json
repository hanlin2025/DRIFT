{
  "name": "drift-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/require-vercel-deployment-approval.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @disposable-database",
    "test:e2e:shipment": "node ../scripts/run-shipment-retrieval.mjs",
    "test:e2e:map": "node ../scripts/run-map-monitoring.mjs",
    "test:e2e:import": "node ../scripts/run-shipment-import.mjs",
    "test:e2e:assignment": "node ../scripts/run-assignment-isolation.mjs",
    "test:e2e:detail": "node ../scripts/run-shipment-detail.mjs",
    "test:e2e:recommendation-decision": "node ../scripts/run-recommendation-decision.mjs",
    "test:e2e:archive": "node ../scripts/run-shipment-archive.mjs",
    "test:e2e:profile": "node ../scripts/run-profile.mjs",
    "test:e2e:vessel-details": "node ../scripts/run-vessel-details.mjs",
    "test:e2e:cdg201-replay": "node ../scripts/run-cdg201-readonly-replay.mjs",
    "test:e2e:arrival-comparison": "node ../scripts/run-arrival-comparison.mjs",
    "test:e2e:remaining-connection-window": "node ../scripts/run-remaining-connection-window.mjs",
    "test:e2e:account-removal": "node ../scripts/run-account-removal.mjs",
    "test:e2e:organisation-creation": "node ../scripts/run-organisation-creation.mjs",
    "test:e2e:account-reactivation": "node ../scripts/run-account-reactivation.mjs",
    "test:e2e:deadline": "node ../scripts/run-transshipment-arrival-deadline.mjs",
    "test:e2e:delay-comparison": "node ../scripts/run-delay-comparison.mjs",
    "test:e2e:history": "node ../scripts/run-shipment-history.mjs",
    "test:e2e:late-arrival-chance": "node ../scripts/run-late-arrival-chance.mjs",
    "test:e2e:first-admin": "node ../scripts/run-first-admin-setup.mjs",
    "test:e2e:admin-invitation": "node ../scripts/run-admin-invitation.mjs",
    "test:e2e:join-path": "node ../scripts/run-join-path.mjs",
    "test:e2e:invitation-withdrawal": "node ../scripts/run-invitation-withdrawal.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
